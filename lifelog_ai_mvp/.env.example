# Copy this file to .env. Provider credentials are intentionally not committed.
# OpenAI-compatible LLM provider. OpenRouter accepts its own API key and a
# currently available free model ID; exact models and free quotas can change.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LIFELOG_LLM_API_KEY=
LIFELOG_LLM_BASE_URL=
LIFELOG_LLM_MODEL=
# Optional: grants the matching account access to usage and health metrics.
LIFELOG_ADMIN_EMAIL=

# Account verification and password-reset mail. Choose smtp, brevo, or console.
# Console is development-only; Brevo requires a verified sender and API key.
LIFELOG_EMAIL_BACKEND=
LIFELOG_BREVO_API_KEY=
LIFELOG_EMAIL_FROM_NAME=LifeLog AI

# SMTP settings are used for account email and legacy Streamlit task reminders.
LIFELOG_SMTP_HOST=
LIFELOG_SMTP_PORT=587
LIFELOG_SMTP_FROM_EMAIL=
LIFELOG_SMTP_USERNAME=
LIFELOG_SMTP_PASSWORD=
LIFELOG_SMTP_USE_SSL=false
LIFELOG_SMTP_USE_STARTTLS=true

# Optional; use the same SQLite path for Streamlit and the reminder worker.
LIFELOG_DB_PATH=lifelog.db

# FastAPI account API (local SQLite is the default; PostgreSQL is supported).
LIFELOG_AUTH_DATABASE_URL=sqlite:///./lifelog.db
LIFELOG_AUTO_CREATE_SCHEMA=true
APP_ENV=development
LIFELOG_FRONTEND_URL=http://localhost:5173
LIFELOG_FRONTEND_ORIGIN=http://localhost:5173
